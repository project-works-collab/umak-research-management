[Unit]
Description=Verify CRM offsite backup freshness
OnFailure=crm-backup-alert.service

[Service]
Type=oneshot
User=crm-backup
WorkingDirectory=/opt/crm
EnvironmentFile=/etc/crm/backup.env
ExecStart=/usr/bin/node /opt/crm/scripts/backup-freshness.js
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
