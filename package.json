{
  "name": "crm-ias-security",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.js",
    "demo:sqli": "node --env-file-if-exists=.env scripts/demo-sqli.js",
    "demo:secret": "node scripts/demo-secret.js",
    "check:secrets": "node scripts/scan-secrets.js",
    "check:static": "node scripts/static-check.js",
    "backup:verify": "node --env-file-if-exists=.env scripts/backup-restore.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-db.js",
    "test:features:unit": "node --test test/edf-heap.test.js",
    "bench:features": "node --env-file-if-exists=.env benchmarks/benchmark-features.js",
    "test:ias:unit": "node --test test/ias-unit.test.js test/ias-plan-baseline.test.js test/session-tokens.test.js",
    "test:integrity:db": "node --env-file-if-exists=.env --test --test-concurrency=1 test/integrity-workflows.test.js",
    "test:ias:db": "node --env-file-if-exists=.env --test --test-concurrency=1 test/ias-controls.test.js",
    "demo:ias": "node --env-file-if-exists=.env scripts/demo-ias.js",
    "bench:ias": "node --env-file-if-exists=.env benchmarks/benchmark-ias.js",
    "backup:offsite": "node --env-file-if-exists=.env scripts/backup-offsite.js",
    "backup:restore:encrypted": "node --env-file-if-exists=.env scripts/restore-encrypted.js",
    "backup:freshness": "node --env-file-if-exists=.env scripts/backup-freshness.js",
    "privacy:maintain": "node --env-file-if-exists=.env scripts/privacy-maintenance.js",
    "check:skills": "node scripts/check-skills.js",
    "test:skills": "node --test test/skill-integrity.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@node-rs/argon2": "^2.2.2",
    "@smithy/node-http-handler": "^4.14.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^8.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "yazl": "^3.3.1"
  }
}
