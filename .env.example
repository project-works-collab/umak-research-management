# Local synthetic-data environment only. Never commit .env.
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://crm_app:REPLACE_LOCAL_PASSWORD@127.0.0.1:5432/crm_ias
# Migration/seed and isolated tests only; never used by the running API.
ADMIN_DATABASE_URL=postgresql://postgres:REPLACE_ADMIN_PASSWORD@127.0.0.1:5432/crm_ias
POSTGRES_PASSWORD=REPLACE_ADMIN_PASSWORD
APP_DB_PASSWORD=REPLACE_LOCAL_PASSWORD
DEMO_PASSWORD=REPLACE_DEMO_PASSWORD
ALLOW_SYNTHETIC_SETUP=yes
ALLOW_ISOLATED_DEMO=yes

# Optional private-document service (disabled/fails closed until both are configured).
S3_BUCKET=
AWS_REGION=ap-southeast-1
# R2/custom S3 endpoint must be HTTPS; provider configuration is separately verified.
S3_ENDPOINT=
S3_KMS_KEY_ID=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Production API and database require verified TLS 1.3.
TLS_CERT_FILE=
TLS_KEY_FILE=
DB_TLS_CA_FILE=
# Backup keys are outside the dump; file contains 32 random bytes encoded as hex, mode 0600.
BACKUP_KEY_FILE=
BACKUP_S3_BUCKET=
BACKUP_STATUS_FILE=
# Required in production; generate with: openssl rand -hex 32
# Share securely across API replicas. Rotation invalidates existing sessions.
JWT_SIGNING_KEY=
